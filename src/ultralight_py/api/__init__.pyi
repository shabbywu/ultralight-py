from collections.abc import Callable, Iterable, Iterator, MutableMapping, MutableSequence, Sequence
from os import PathLike
from pathlib import Path
from typing import Any, Literal, TypedDict, TypeVar, overload

from typing_extensions import Self

from ultralight_py import (
    FrameEvent as _FrameEvent,
)
from ultralight_py import (
    LoadFailure as _LoadFailure,
)
from ultralight_py import (
    Resource as _Resource,
)
from ultralight_py import (
    UltralightError as _UltralightError,
)
from ultralight_py.events import Subscription as Subscription
from ultralight_py.images import RGBAImage
from ultralight_py.input import InputView as _InputView
from ultralight_py.objects import PythonBinding as PythonBinding

_T = TypeVar("_T")

class _ConsoleEvent(TypedDict):
    message: str
    source: int
    type: int
    level: int
    source_url: str
    line: int
    column: int

class PixelBuffer:
    def __init__(
        self,
        width: int,
        height: int,
        row_bytes: int,
        format: str,
        dirty_bounds: tuple[int, int, int, int],
        data: bytes,
    ) -> None: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def row_bytes(self) -> int: ...
    @property
    def format(self) -> str: ...
    @property
    def dirty_bounds(self) -> tuple[int, int, int, int]: ...
    @property
    def data(self) -> bytes: ...
    def to_rgba(self) -> RGBAImage: ...

class Session:
    @property
    def name(self) -> str: ...
    @property
    def persistent(self) -> bool: ...
    @property
    def disk_path(self) -> Path | None: ...
    @property
    def closed(self) -> bool: ...
    def close(self, *, force_close: bool = False) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...

class Runtime:
    def __new__(
        cls,
        *,
        assets_root: str | PathLike[str] | None = None,
        resource_loader: Callable[[str], bytes | _Resource | None] | None = None,
        cache_path: str | PathLike[str] | None = None,
    ) -> Self: ...
    @property
    def closed(self) -> bool: ...
    def create_session(self, name: str, *, persistent: bool = False) -> Session: ...
    def get_session(self, name: str) -> Session | None: ...
    def get_or_create_session(self, name: str, *, persistent: bool = False) -> Session: ...
    def create_view(
        self,
        width: int,
        height: int,
        *,
        transparent: bool = False,
        session: Session | None = None,
    ) -> View: ...
    def update(self) -> None: ...
    def refresh_display(self, display_id: int = 0) -> None: ...
    def render(self) -> None: ...
    def set_error_handler(self, callback: Callable[[_UltralightError], Any] | None) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...

class View(_InputView):
    @property
    def session(self) -> Session | None: ...
    @property
    def closed(self) -> bool: ...
    @property
    def is_ready(self) -> bool: ...
    @property
    def is_settled(self) -> bool: ...
    @property
    def navigation_id(self) -> int: ...
    @property
    def load_failure(self) -> _LoadFailure | None: ...
    @overload
    def on(
        self,
        event: Literal["begin_loading", "window_ready", "dom_ready", "finish_loading"],
        callback: Callable[[_FrameEvent], Any],
    ) -> Subscription: ...
    @overload
    def on(
        self, event: Literal["fail_loading"], callback: Callable[[_LoadFailure], Any]
    ) -> Subscription: ...
    @overload
    def on(
        self, event: Literal["console"], callback: Callable[[_ConsoleEvent], Any]
    ) -> Subscription: ...
    @overload
    def on(
        self, event: Literal["page_settled"], callback: Callable[[str], Any]
    ) -> Subscription: ...
    async def wait_ready(self, timeout: float = 5) -> None: ...
    async def wait_settled(self, timeout: float = 5) -> None: ...
    async def wait_until(self, predicate: Callable[[], _T], timeout: float = 5) -> _T: ...
    async def wait_for_selector(self, selector: str, timeout: float = 5) -> bool: ...
    def load_html(self, html: str, url: str = "") -> None: ...
    def load_url(self, url: str) -> None: ...
    def resize(self, width: int, height: int) -> None: ...
    def set_callbacks(
        self,
        *,
        begin_loading: Callable[[_FrameEvent], Any] | None = None,
        window_ready: Callable[[_FrameEvent], Any] | None = None,
        dom_ready: Callable[[_FrameEvent], Any] | None = None,
        finish_loading: Callable[[_FrameEvent], Any] | None = None,
        fail_loading: Callable[[_LoadFailure], Any] | None = None,
        console: Callable[[_ConsoleEvent], Any] | None = None,
        page_settled: Callable[[str], Any] | None = None,
    ) -> None: ...
    async def evaluate_async(self, source: str, *, copy: bool = False) -> Any: ...
    def evaluate(self, source: str, *, copy: bool = False) -> Any: ...
    def evaluate_handle(self, source: str) -> JSValue: ...
    def bind_object(
        self, name: str, instance: object, *, members: Sequence[str] | None = None
    ) -> PythonBinding: ...
    def bind_function(self, name: str, callback: Callable[..., Any]) -> PythonBinding: ...
    def unbind(self, name: str) -> None: ...
    def copy_pixels(self) -> PixelBuffer: ...
    def clear_dirty_bounds(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...

class JSValue:
    @property
    def closed(self) -> bool: ...
    def get(self, key: str | int) -> JSValue: ...
    def set(self, key: str | int, value: Any) -> None: ...
    def keys(self) -> list[str]: ...
    def call(self, *args: Any, this: JSValue | None = None) -> JSValue: ...
    async def await_result(self) -> JSValue: ...
    async def call_async(self, *args: Any, this: JSValue | None = None) -> JSValue: ...
    def to_python(self, *, copy: bool = False) -> Any: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...

class _JSContainer:
    @property
    def closed(self) -> bool: ...
    def to_python(self, *, copy: bool = False) -> Any: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...

class JSArray(_JSContainer, MutableSequence[Any]):
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, key: int) -> Any: ...
    @overload
    def __getitem__(self, key: slice) -> list[Any]: ...
    @overload
    def __setitem__(self, key: int, value: Any) -> None: ...
    @overload
    def __setitem__(self, key: slice, value: Iterable[Any]) -> None: ...
    def __delitem__(self, key: int | slice) -> None: ...
    def insert(self, position: int, value: Any) -> None: ...
    def sort(self, *, key: Callable[[Any], Any] | None = None, reverse: bool = False) -> None: ...
    def copy(self) -> list[Any]: ...

class JSObject(_JSContainer, MutableMapping[str, Any]):
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[str]: ...
    def __getitem__(self, key: str) -> Any: ...
    def __setitem__(self, key: str, value: Any) -> None: ...
    def __delitem__(self, key: str) -> None: ...
    def copy(self) -> dict[str, Any]: ...
