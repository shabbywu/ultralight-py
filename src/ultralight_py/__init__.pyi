from .input import (InputView as _InputView, MouseButton as MouseButton, MouseEvent as MouseEvent,
                    MouseEventType as MouseEventType, ScrollEvent as ScrollEvent, ScrollEventType as ScrollEventType)
from os import PathLike
from typing import Any, Callable, TypedDict
from enum import Enum

class ErrorCode(Enum):
    InvalidArgument = ...
    WrongThread = ...
    Closed = ...
    Busy = ...
    PageGone = ...
    CrossContext = ...
    ScriptException = ...
    HostException = ...
    Unsupported = ...
    TypeMismatch = ...
    TraversalLimit = ...

class UltralightError(RuntimeError):
    code: ErrorCode
    stack: str
    source_url: str
    line: float
    column: float
class JavaScriptError(UltralightError): ...
class _Undefined: ...
undefined: _Undefined

class Resource:
    def __init__(self, data: bytes, mime_type: str | None = None, charset: str = "utf-8") -> None: ...
    @property
    def data(self) -> bytes: ...
    @property
    def mime_type(self) -> str: ...
    @property
    def charset(self) -> str: ...

class FrameEvent:
    @property
    def frame_id(self) -> int: ...
    @property
    def is_main_frame(self) -> bool: ...
    @property
    def url(self) -> str: ...
class LoadFailure:
    @property
    def frame(self) -> FrameEvent: ...
    @property
    def description(self) -> str: ...
    @property
    def domain(self) -> str: ...
    @property
    def code(self) -> int: ...
class _ConsoleEvent(TypedDict):
    message: str
    source: int
    type: int
    level: int
    source_url: str
    line: int
    column: int

class PixelBuffer:
    def __init__(self, width: int, height: int, row_bytes: int, format: str,
                 dirty_bounds: tuple[int, int, int, int], data: bytes) -> None: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def row_bytes(self) -> int: ...
    @property
    def format(self) -> str: ...
    @property
    def dirty_bounds(self) -> tuple[int, int, int, int]: ...
    @property
    def data(self) -> bytes: ...

class Runtime:
    def __new__(cls, *, assets_root: str | PathLike[str] | None = None,
                resource_loader: Callable[[str], bytes | Resource | None] | None = None) -> Runtime: ...
    @property
    def closed(self) -> bool: ...
    def create_view(self, width: int, height: int, *, transparent: bool = False) -> View: ...
    def update(self) -> None: ...
    def refresh_display(self, display_id: int = 0) -> None: ...
    def render(self) -> None: ...
    def set_error_handler(self, callback: Callable[[UltralightError], Any] | None) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Runtime: ...
    def __exit__(self, *exc: Any) -> None: ...

class View(_InputView):
    @property
    def closed(self) -> bool: ...
    def load_html(self, html: str, url: str = "") -> None: ...
    def load_url(self, url: str) -> None: ...
    def resize(self, width: int, height: int) -> None: ...
    def set_callbacks(self, *, begin_loading: Callable[[FrameEvent], Any] | None = None,
                      window_ready: Callable[[FrameEvent], Any] | None = None,
                      dom_ready: Callable[[FrameEvent], Any] | None = None,
                      finish_loading: Callable[[FrameEvent], Any] | None = None,
                      fail_loading: Callable[[LoadFailure], Any] | None = None,
                      console: Callable[[_ConsoleEvent], Any] | None = None) -> None: ...
    def evaluate(self, source: str) -> Any: ...
    def evaluate_handle(self, source: str) -> JSValue: ...
    def bind_function(self, name: str, callback: Callable[..., Any]) -> None: ...
    def copy_pixels(self) -> PixelBuffer: ...
    def clear_dirty_bounds(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> View: ...
    def __exit__(self, *exc: Any) -> None: ...

class JSValue:
    @property
    def closed(self) -> bool: ...
    def get(self, key: str | int) -> JSValue: ...
    def set(self, key: str | int, value: Any) -> None: ...
    def keys(self) -> list[str]: ...
    def call(self, *args: Any, this: JSValue | None = None) -> JSValue: ...
    def to_python(self) -> Any: ...
    def close(self) -> None: ...
    def __enter__(self) -> JSValue: ...
    def __exit__(self, *exc: Any) -> None: ...
