from dataclasses import dataclass
from enum import IntEnum, IntFlag

class MouseEventType(IntEnum):
    MOVE = 0
    DOWN = 1
    UP = 2

class MouseButton(IntEnum):
    NONE = 0
    LEFT = 1
    MIDDLE = 2
    RIGHT = 3
    BACK = 4
    FORWARD = 5

class ScrollEventType(IntEnum):
    PIXEL = 0
    PAGE = 1

class KeyEventType(IntEnum):
    KEY_DOWN = 0
    KEY_UP = 1
    RAW_KEY_DOWN = 2
    CHAR = 3

class Modifiers(IntFlag):
    NONE = 0
    ALT = 1
    CTRL = 2
    META = 4
    SHIFT = 8

