from collections.abc import Awaitable, Callable
from typing import Any, Literal, Protocol, TypeVar

from typing_extensions import Self

from ultralight_py.api import Runtime, View

_T = TypeVar("_T")

class _Step(Protocol):
    def __call__(self, *, render: bool = False) -> Awaitable[None]: ...

class ScriptDriver:
    runtime: Runtime
    closed: bool
    def __init__(self, runtime: Runtime, *, step: _Step | None = None) -> None: ...
    @classmethod
    def auto(
        cls, runtime: Runtime, *, update_interval: float = 1 / 60, display_id: int = 0
    ) -> Self: ...
    def page(self, view: View) -> ScriptPage: ...
    def close(self, error: BaseException | None = None) -> None: ...
    async def __aenter__(self) -> Self: ...
    async def __aexit__(self, *exc: object) -> None: ...

class NavigationExpectation:
    async def __aenter__(self) -> Self: ...
    async def __aexit__(self, *exc: object) -> bool: ...

class ScriptPage:
    @property
    def view(self) -> View: ...
    async def wait_ready(self, timeout: float = 30) -> None: ...
    async def wait_settled(self, timeout: float = 30) -> None: ...
    async def wait_until(
        self, predicate: Callable[[], _T], timeout: float = 30, *, render: bool = False
    ) -> _T: ...
    async def wait_for_selector(
        self, selector: str, timeout: float = 30, *, render: bool = False
    ) -> bool: ...
    async def evaluate(
        self, source: str, timeout: float = 30, *, render: bool = True, copy: bool = False
    ) -> Any: ...
    def expect_navigation(
        self, *, wait_until: Literal["ready", "settled"] = "ready", timeout: float = 30
    ) -> NavigationExpectation: ...
    async def navigate(
        self, url: str, *, wait_until: Literal["ready", "settled"] = "ready", timeout: float = 30
    ) -> None: ...
    async def load_html(
        self,
        html: str,
        url: str = "",
        *,
        wait_until: Literal["ready", "settled"] = "ready",
        timeout: float = 30,
    ) -> None: ...
