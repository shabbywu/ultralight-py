from collections.abc import Callable, Sequence
from os import PathLike
from typing import Any, ClassVar, Literal, TypedDict, TypeVar, overload

from typing_extensions import Self

from ultralight_py.events import Subscription as Subscription
from ultralight_py.input import InputView as _InputView
from ultralight_py.objects import PythonBinding as PythonBinding

_T = TypeVar("_T")

class ErrorCode:
    InvalidArgument: ClassVar[ErrorCode]
    WrongThread: ClassVar[ErrorCode]
    Closed: ClassVar[ErrorCode]
    Busy: ClassVar[ErrorCode]
    PageGone: ClassVar[ErrorCode]
    CrossContext: ClassVar[ErrorCode]
    ScriptException: ClassVar[ErrorCode]
    HostException: ClassVar[ErrorCode]
    Unsupported: ClassVar[ErrorCode]
    TypeMismatch: ClassVar[ErrorCode]
    TraversalLimit: ClassVar[ErrorCode]
    __members__: ClassVar[dict[str, ErrorCode]]
    def __init__(self, value: int) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> int: ...
    def __int__(self) -> int: ...

class UltralightError(RuntimeError):
    code: ErrorCode
    stack: str
    source_url: str
    line: float
    column: float

class JavaScriptError(UltralightError): ...
class _Undefined: ...

undefined: _Undefined

class Resource:
    def __init__(
        self, data: bytes, mime_type: str | None = None, charset: str = "utf-8"
    ) -> None: ...
    @property
    def data(self) -> bytes: ...
    @property
    def mime_type(self) -> str: ...
    @property
    def charset(self) -> str: ...

class FrameEvent:
    @property
    def frame_id(self) -> int: ...
    @property
    def is_main_frame(self) -> bool: ...
    @property
    def url(self) -> str: ...

class LoadFailure:
    @property
    def frame(self) -> FrameEvent: ...
    @property
    def description(self) -> str: ...
    @property
    def domain(self) -> str: ...
    @property
    def code(self) -> int: ...

class PageLoadError(RuntimeError):
    failure: LoadFailure
    def __init__(self, failure: LoadFailure) -> None: ...

class _ConsoleEvent(TypedDict):
    message: str
    source: int
    type: int
    level: int
    source_url: str
    line: int
    column: int

class PixelBuffer:
    def __init__(
        self,
        width: int,
        height: int,
        row_bytes: int,
        format: str,
        dirty_bounds: tuple[int, int, int, int],
        data: bytes,
    ) -> None: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def row_bytes(self) -> int: ...
    @property
    def format(self) -> str: ...
    @property
    def dirty_bounds(self) -> tuple[int, int, int, int]: ...
    @property
    def data(self) -> bytes: ...

class Runtime:
    def __new__(
        cls,
        *,
        assets_root: str | PathLike[str] | None = None,
        resource_loader: Callable[[str], bytes | Resource | None] | None = None,
        cache_path: str | PathLike[str] | None = None,
    ) -> Self: ...
    @property
    def closed(self) -> bool: ...
    def create_view(self, width: int, height: int, *, transparent: bool = False) -> View: ...
    def update(self) -> None: ...
    def refresh_display(self, display_id: int = 0) -> None: ...
    def render(self) -> None: ...
    def set_error_handler(self, callback: Callable[[UltralightError], Any] | None) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...

class View(_InputView):
    @property
    def closed(self) -> bool: ...
    @property
    def is_ready(self) -> bool: ...
    @property
    def is_settled(self) -> bool: ...
    @property
    def navigation_id(self) -> int: ...
    @property
    def load_failure(self) -> LoadFailure | None: ...
    @overload
    def on(
        self,
        event: Literal["begin_loading", "window_ready", "dom_ready", "finish_loading"],
        callback: Callable[[FrameEvent], Any],
    ) -> Subscription: ...
    @overload
    def on(
        self, event: Literal["fail_loading"], callback: Callable[[LoadFailure], Any]
    ) -> Subscription: ...
    @overload
    def on(
        self, event: Literal["console"], callback: Callable[[_ConsoleEvent], Any]
    ) -> Subscription: ...
    @overload
    def on(
        self, event: Literal["page_settled"], callback: Callable[[str], Any]
    ) -> Subscription: ...
    async def wait_ready(self, timeout: float = 5) -> None: ...
    async def wait_settled(self, timeout: float = 5) -> None: ...
    async def wait_until(self, predicate: Callable[[], _T], timeout: float = 5) -> _T: ...
    async def wait_for_selector(self, selector: str, timeout: float = 5) -> bool: ...
    def load_html(self, html: str, url: str = "") -> None: ...
    def load_url(self, url: str) -> None: ...
    def resize(self, width: int, height: int) -> None: ...
    def set_callbacks(
        self,
        *,
        begin_loading: Callable[[FrameEvent], Any] | None = None,
        window_ready: Callable[[FrameEvent], Any] | None = None,
        dom_ready: Callable[[FrameEvent], Any] | None = None,
        finish_loading: Callable[[FrameEvent], Any] | None = None,
        fail_loading: Callable[[LoadFailure], Any] | None = None,
        console: Callable[[_ConsoleEvent], Any] | None = None,
        page_settled: Callable[[str], Any] | None = None,
    ) -> None: ...
    async def evaluate_async(self, source: str) -> Any: ...
    def evaluate(self, source: str) -> Any: ...
    def evaluate_handle(self, source: str) -> JSValue: ...
    def bind_object(
        self, name: str, instance: object, *, members: Sequence[str] | None = None
    ) -> PythonBinding: ...
    def bind_function(self, name: str, callback: Callable[..., Any]) -> PythonBinding: ...
    def unbind(self, name: str) -> None: ...
    def copy_pixels(self) -> PixelBuffer: ...
    def clear_dirty_bounds(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...

class JSValue:
    @property
    def closed(self) -> bool: ...
    def get(self, key: str | int) -> JSValue: ...
    def set(self, key: str | int, value: Any) -> None: ...
    def keys(self) -> list[str]: ...
    def call(self, *args: Any, this: JSValue | None = None) -> JSValue: ...
    async def await_result(self) -> JSValue: ...
    async def call_async(self, *args: Any, this: JSValue | None = None) -> JSValue: ...
    def to_python(self) -> Any: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...
