from collections.abc import Callable, Sequence
from typing import TypeVar, overload

from typing_extensions import Self

from ultralight_py.api import View

_F = TypeVar("_F", bound=Callable)

class API:
    @property
    def namespace(self) -> str: ...
    def __init__(self, namespace: str) -> None: ...
    @property
    def closed(self) -> bool: ...
    @overload
    def register(self, callback: _F, *, name: str | None = None) -> _F: ...
    @overload
    def register(self, callback: None = None, *, name: str | None = None) -> Callable[[_F], _F]: ...
    def register_object(
        self, name: str, instance: object, *, members: Sequence[str] | None = None
    ) -> None: ...
    def unregister(self, name: str) -> None: ...
    def attach(self, view: View) -> None: ...
    def detach(self, view: View) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...
