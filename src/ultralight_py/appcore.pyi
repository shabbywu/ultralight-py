from collections.abc import Callable
from os import PathLike
from typing import Literal

from typing_extensions import Self

from ultralight_py.api import Resource, Runtime, Session, View
from ultralight_py.events import Subscription

class Window:
    view: View
    @property
    def closed(self) -> bool: ...
    @property
    def width(self) -> float: ...
    @property
    def height(self) -> float: ...
    @property
    def device_width(self) -> int: ...
    @property
    def device_height(self) -> int: ...
    @property
    def device_scale(self) -> float: ...
    @property
    def title(self) -> str: ...
    @title.setter
    def title(self, value: str) -> None: ...
    def on(
        self, event: Literal["closed", "resized"], callback: Callable[[object], object]
    ) -> Subscription: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...

class Application:
    runtime: Runtime
    def __init__(
        self,
        *,
        assets_root: str | PathLike[str] | None = None,
        resource_loader: Callable[[str], bytes | Resource | None] | None = None,
        cache_path: str | PathLike[str] | None = None,
        app_name: str = "ultralight-py",
        developer_name: str = "ultralight-py",
        force_cpu_renderer: bool = False,
    ) -> None: ...
    @property
    def closed(self) -> bool: ...
    def create_window(
        self,
        width: float,
        height: float,
        *,
        title: str = "",
        session: Session | None = None,
        view: View | None = None,
        transparent: bool = False,
        resizable: bool = True,
        fullscreen: bool = False,
    ) -> Window: ...
    def run_once(self) -> bool: ...
    def run(self) -> None: ...
    async def run_async(self, update_interval: float = 1 / 60) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> None: ...
